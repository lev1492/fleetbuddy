[Unit]
Description=FleetBuddy - controllo aggiornamenti
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/tools/update.sh --auto
# esce con 10 quando c'è un aggiornamento non installato: non è un errore
SuccessExitStatus=10
